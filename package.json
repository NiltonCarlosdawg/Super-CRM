{
  "name": "milvendas-crm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/infra/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "eval": "tsx tests/eval/run.ts",
    "test:integration": "bash scripts/integration-test.sh",
    "test:containers:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:containers:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "ws": "^8.22.0"
  }
}
