NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://crm:change-me@127.0.0.1:5432/crm
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

# Autenticação (Fase 1) — placeholders não funcionais; nunca valores reais
AUTH_SECRET=<32+ caracteres aleatórios>
AUTH_TOTP_ISSUER=MilVendas
AUTH_SESSION_TTL_HOURS=72
AUTH_LOGIN_RATE_MAX=5
AUTH_LOGIN_RATE_WINDOW_MS=300000
AUTH_LOGIN_LOCK_MAX_MS=900000
HTTP_RATE_MAX=300
HTTP_RATE_WINDOW_MS=60000
HTTP_BODY_LIMIT_BYTES=1048576

# Mensagens / WA-AKG (Fase 1) — placeholders não funcionais
WA_AKG_BASE_URL=http://wa-akg:3001
WA_AKG_API_KEY=<chave da API do WA-AKG>
WA_WEBHOOK_SECRET=<32+ caracteres aleatórios>
WA_REPLY_DELAY_MS=1000-5000
WA_SEND_TIMEOUT_MS=15000
WA_SEND_MAX_ATTEMPTS=5
WA_OUTBOX_RETRY_DELAY_MS=30000
WA_OUTBOX_TICK_MS=1000
WA_CLAIM_TTL_MS=60000
