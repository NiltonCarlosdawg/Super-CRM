# Reverse proxy para o backend (mesma origem: /v1 e Socket.IO) — ADR-0016.
# Porta fixa do G5: PORT=3002 no .env de produção de api.supercrm.milvendas.ao.
# G6/G7 provado (2026-11-11): alvo ws:// para o 101 chegar ao cliente; http://
# preserva query mas não entrega 101. Em alvos ws:// o LiteSpeed corta a query
# (medido 2026-11-12) — o upgrade WS falha mas o engine.io fica em polling.
# FallbackResource não suportado; fallback SPA é RewriteRule.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # WebSocket do Socket.IO (handshake 101; query cortada em ws:// — polling fallback)
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^(v1|socket\.io)(.*)$ ws://127.0.0.1:3002/$1$2 [P,L]

  # REST /v1 e polling do Socket.IO
  RewriteRule ^(v1|socket\.io)(.*)$ http://127.0.0.1:3002/$1$2 [P,L]

  # SPA (BrowserRouter): rotas deep-link servidas pelo index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
