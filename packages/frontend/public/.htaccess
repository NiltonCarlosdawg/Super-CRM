# Reverse proxy para o backend (mesma origem: /v1 e Socket.IO) — ADR-0016.
# Porta fixa do G5: PORT=3002 no .env de produção de api.supercrm.milvendas.ao.
# G6/G7 provado no servidor (2026-11-11): o alvo do upgrade tem de ser ws:// —
# com http:// o LiteSpeed recebe o pedido mas nunca encaminha o 101 (trava).
# FallbackResource não é suportado neste LiteSpeed; o fallback SPA é RewriteRule.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # WebSocket do Socket.IO (handshake 101)
  RewriteCond %{HTTP:Upgrade} =websocket [NC]
  RewriteRule ^(v1|socket\.io)(.*)$ ws://127.0.0.1:3002/$1$2 [P,L]

  # REST /v1 e polling do Socket.IO
  RewriteRule ^(v1|socket\.io)(.*)$ http://127.0.0.1:3002/$1$2 [P,L]

  # SPA (BrowserRouter): rotas deep-link servidas pelo index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
